{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Universal Creative Software Hub app catalog manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "publisher",
    "description",
    "categories",
    "platforms",
    "pricingModel",
    "links"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 240
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "windows",
          "macos",
          "linux"
        ]
      }
    },
    "pricingModel": {
      "enum": [
        "free-open-source",
        "freeware"
      ]
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "website",
        "download"
      ],
      "properties": {
        "website": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "download": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "sourceCode": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        }
      }
    }
  }
}

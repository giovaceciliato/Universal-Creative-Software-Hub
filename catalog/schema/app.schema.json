{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Universal Creative Software Hub application metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "publisher",
    "description",
    "categories",
    "platforms",
    "pricingModel",
    "links"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 240
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "windows",
          "macos",
          "linux",
          "web"
        ]
      }
    },
    "pricingModel": {
      "enum": [
        "free-open-source",
        "freeware"
      ]
    },
    "icon": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "source",
        "license"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/icons/[a-z0-9-]+\\.(?:svg|png)$"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "integrations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "windows": {
          "$ref": "#/$defs/platformIntegration"
        },
        "macos": {
          "$ref": "#/$defs/platformIntegration"
        },
        "linux": {
          "$ref": "#/$defs/platformIntegration"
        }
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "website",
        "download"
      ],
      "properties": {
        "website": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "download": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "sourceCode": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        }
      }
    }
  },
  "$defs": {
    "platformIntegration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "executableNames": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.+-]+$"
          }
        },
        "bundleNames": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.+-]+$"
          }
        },
        "desktopIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.+-]+$"
          }
        },
        "wingetIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.+-]+$"
          }
        },
        "homebrewCasks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.+-]+$"
          }
        },
        "flatpakIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.+-]+$"
          }
        },
        "rpmNames": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.+-]+$"
          }
        }
      }
    }
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Universal Creative Software Hub",
  "version": "0.1.0",
  "identifier": "dev.giovaceciliato.universalcreativesoftwarehub",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Universal Creative Software Hub",
        "width": 1300,
        "height": 820,
        "minWidth": 950,
        "minHeight": 620,
        "backgroundColor": "#11111c"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
